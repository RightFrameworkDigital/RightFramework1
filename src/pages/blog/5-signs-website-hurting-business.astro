<script>
  const slug = '5-signs-website-hurting-business';
  const likeKey = `likes_${slug}`;
  const commentsKey = `comments_${slug}`;

  let likes = parseInt(localStorage.getItem(likeKey) || '0');
  const likeBtn = document.getElementById('likeBtn');
  const likeCount = document.getElementById('likeCount');
  if (likeCount) likeCount.textContent = String(likes);
  likeBtn?.addEventListener('click', () => {
    likes++;
    localStorage.setItem(likeKey, String(likes));
    if (likeCount) likeCount.textContent = String(likes);
    likeBtn.classList.add('liked');
  });

  let comments = JSON.parse(localStorage.getItem(commentsKey) || '[]');
  const commentsList = document.getElementById('commentsList');
  const commentForm = document.getElementById('commentForm');

  function renderComments() {
    if (!commentsList) return;
    commentsList.innerHTML = comments.length === 0
      ? '<p class="no-comments">No comments yet. Be the first!</p>'
      : comments.map(c => `<div class="comment-item"><div class="comment-meta"><strong>${c.name}</strong><span>${c.date}</span></div><p>${c.text}</p></div>`).join('');
  }
  renderComments();

  commentForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nameEl = document.getElementById('commentName');
    const textEl = document.getElementById('commentText');
    const name = (nameEl as HTMLInputElement).value.trim();
    const text = (textEl as HTMLTextAreaElement).value.trim();
    if (!name || !text) return;
    comments.push({ name, text, date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) });
    localStorage.setItem(commentsKey, JSON.stringify(comments));
    renderComments();
    (nameEl as HTMLInputElement).value = '';
    (textEl as HTMLTextAreaElement).value = '';
  });
</script>

