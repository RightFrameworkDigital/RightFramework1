<script type="module">
  import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

  const SUPABASE_URL = 'https://ueamxuwrpfokcghpypzg.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVlYW14dXdycGZva2NnaHB5cHpnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4NTA5NzksImV4cCI6MjA5NTQyNjk3OX0.WqFwt2ZtUKlERx9O8ge-ZxQBZCd5Gff7VUPhqJOyy_M';
  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const slug = 'adult-family-homes-google-search';
  const likeBtn = document.getElementById('likeBtn');
  const likeCount = document.getElementById('likeCount');
  const commentsList = document.getElementById('commentsList');
  const commentForm = document.getElementById('commentForm');

  async function loadLikes() {
    const { data } = await supabase.from('likes').select('count').eq('blog_slug', slug).maybeSingle();
    if (likeCount) likeCount.textContent = String(data?.count ?? 0);
  }

  async function loadComments() {
    const { data } = await supabase.from('comments').select('name, comment, created_at').eq('blog_slug', slug).order('created_at', { ascending: true });
    renderComments(data ?? []);
  }

  function renderComments(comments) {
    if (!commentsList) return;
    commentsList.innerHTML = comments.length === 0
      ? '<p class="no-comments">No comments yet. Be the first!</p>'
      : comments.map((c) => {
          const date = new Date(c.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          return `<div class="comment-item"><div class="comment-meta"><strong>${c.name}</strong><span>${date}</span></div><p>${c.comment}</p></div>`;
        }).join('');
  }

  likeBtn?.addEventListener('click', async () => {
    likeBtn.disabled = true;
    await supabase.rpc('increment_likes', { slug });
    likeBtn.classList.add('liked');
    likeBtn.disabled = false;
  });

  commentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameEl = document.getElementById('commentName');
    const textEl = document.getElementById('commentText');
    const name = nameEl.value.trim();
    const comment = textEl.value.trim();
    if (!name || !comment) return;
    const submitBtn = commentForm.querySelector('.submit-btn');
    if (submitBtn) submitBtn.disabled = true;
    await supabase.from('comments').insert({ blog_slug: slug, name, comment });
    nameEl.value = '';
    textEl.value = '';
    if (submitBtn) submitBtn.disabled = false;
  });

  supabase
    .channel(`blog:${slug}`)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'comments', filter: `blog_slug=eq.${slug}` }, () => {
      loadComments();
    })
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'likes', filter: `blog_slug=eq.${slug}` }, (payload) => {
      if (likeCount) likeCount.textContent = String(payload.new.count);
    })
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'likes', filter: `blog_slug=eq.${slug}` }, (payload) => {
      if (likeCount) likeCount.textContent = String(payload.new.count);
    })
    .subscribe();

  loadLikes();
  loadComments();
</script>
