<script>
  const slug = 'top-5-website-mistakes-seattle';
  let likes = parseInt(localStorage.getItem(`likes_${slug}`) || '0');
  const likeBtn = document.getElementById('likeBtn');
  const likeCount = document.getElementById('likeCount');
  if (likeCount) likeCount.textContent = String(likes);
  likeBtn?.addEventListener('click', () => { likes++; localStorage.setItem(`likes_${slug}`, String(likes)); if (likeCount) likeCount.textContent = String(likes); likeBtn.classList.add('liked'); });
  let comments = JSON.parse(localStorage.getItem(`comments_${slug}`) || '[]');
  const commentsList = document.getElementById('commentsList');
  const commentForm = document.getElementById('commentForm');
  function renderComments() { if (!commentsList) return; commentsList.innerHTML = comments.length === 0 ? '<p class="no-comments">No comments yet. Be the first!</p>' : comments.map((c) => `<div class="comment-item"><div class="comment-meta"><strong>${c.name}</strong><span>${c.date}</span></div><p>${c.text}</p></div>`).join(''); }
  renderComments();
  commentForm?.addEventListener('submit', (e) => { e.preventDefault(); const n = document.getElementById('commentName'); const t = document.getElementById('commentText'); const name = n.value.trim(); const text = t.value.trim(); if (!name || !text) return; comments.push({ name, text, date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) }); localStorage.setItem(`comments_${slug}`, JSON.stringify(comments)); renderComments(); n.value = ''; t.value = ''; });
</script>
<style>
