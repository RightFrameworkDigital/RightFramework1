<style>
/* ── NAV ─────────────────────────────────────────────────── */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  transition: box-shadow 0.25s;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.logo-img {
  width: 32px;
  height: 32px;
  object-fit: contain;
  flex-shrink: 0;
}
.logo-mark {
  width: 30px;
  height: 30px;
  background: var(--blue);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}
.nav-links {
  display: flex;
  align-items: center;
  gap: 2px;
}
.nav-links a {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink-3);
  padding: 7px 13px;
  border-radius: 7px;
  white-space: nowrap;
  transition: color 0.12s, background 0.12s;
}
.nav-links a:hover { color: var(--ink); background: var(--surface); }
.nav-cta {
  background: var(--ink) !important;
  color: var(--white) !important;
  margin-left: 6px;
  padding: 7px 16px !important;
}
.nav-cta:hover { background: #000 !important; }
.nav-call {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  color: var(--ink);
  transition: background 0.15s, border-color 0.15s;
  margin-left: 4px;
}
.nav-call:hover { background: var(--surface); border-color: var(--ink-4); }

.burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 36px;
  height: 36px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.burger span {
  display: block;
  width: 20px;
  height: 1.5px;
  background: var(--ink);
  border-radius: 2px;
  transition: 0.18s;
}
.nav-drawer[hidden] { display: none; }
.nav-drawer {
  border-top: 1px solid var(--line);
  background: var(--white);
  padding: 8px 0 16px;
}
.nav-drawer a {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: var(--ink-2);
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
}
.nav-drawer a:last-child { border-bottom: none; }
.nav-drawer a:hover { color: var(--blue); }

/* ── BUTTONS ─────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 600;
  padding: 11px 22px;
  border-radius: 8px;
  border: 1.5px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  letter-spacing: -0.01em;
  line-height: 1.2;
  transition: background 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.12s;
  text-decoration: none;
}
.btn:active { transform: scale(0.98); }
.btn-lg { padding: 13px 28px; font-size: 15px; }
.btn-full { width: 100%; }
.btn-blue { background: var(--blue); color: #fff; border-color: var(--blue); }
.btn-blue:hover { background: var(--blue-dark); border-color: var(--blue-dark); box-shadow: 0 4px 16px rgba(26,86,219,0.3); transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--ink-2); border-color: var(--line); }
.btn-ghost:hover { border-color: var(--ink-5); background: var(--surface); }
.btn-white { background: #fff; color: var(--ink); border-color: #fff; }
.btn-white:hover { background: var(--surface); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.12); }

/* ── LABELS / SECTION HEADS ──────────────────────────────── */
.label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 12px;
  display: block;
}
.label-inv { color: rgba(255,255,255,0.4); }
.kicker {
  display: inline-block;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
  background: var(--blue-dim);
  padding: 5px 13px;
  border-radius: 100px;
  margin-bottom: 24px;
}
.sec-head { margin-bottom: 56px; }
.sec-head h2 {
  font-size: clamp(30px, 3.5vw, 46px);
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--ink);
  line-height: 1.12;
  max-width: 540px;
}
.sec-head-inv h2 { color: #fff; }

/* ── HERO ────────────────────────────────────────────────── */
.hero {
  padding: 100px 0 96px;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: center;
}
.hero-text h1 {
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.05;
  color: var(--ink);
  margin-bottom: 22px;
}
.hero-text h1 em {
  font-style: italic;
  font-family: var(--font-serif);
  font-weight: 400;
  color: var(--blue);
}
.hero-sub {
  font-size: 17px;
  color: var(--ink-3);
  line-height: 1.7;
  margin-bottom: 36px;
  max-width: 440px;
}
.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }

.hero-visual { position: relative; }
.hero-frame {
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0,0,0,0.12), 0 4px 12px rgba(0,0,0,0.06);
}
.hero-frame img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  display: block;
}
.float {
  position: absolute;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 13px 18px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.float strong { font-size: 18px; font-weight: 700; color: var(--ink); letter-spacing: -0.025em; line-height: 1; }
.float span   { font-size: 11px; color: var(--ink-4); font-weight: 500; }
.float-a { bottom: -16px; left: -24px; animation: floaty 5s ease-in-out infinite; }
.float-b { top: 24px; right: -20px; animation: floaty 5s ease-in-out infinite 2.5s; }
@keyframes floaty {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-7px); }
}

/* ── STATS BAR ───────────────────────────────────────────── */
.stats-bar {
  background: var(--surface);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.stats-row {
  display: flex;
  align-items: center;
  padding-top: 28px;
  padding-bottom: 28px;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: center;
}
.stat strong { font-size: 20px; font-weight: 700; color: var(--ink); letter-spacing: -0.025em; line-height: 1.2; }
.stat span   { font-size: 12px; color: var(--ink-4); font-weight: 500; }
.stat-sep { width: 1px; height: 32px; background: var(--line); flex-shrink: 0; }

/* ── PULL QUOTE ──────────────────────────────────────────── */
.pullquote-section { padding: 100px 0; }
.pullquote { max-width: 760px; }
.pullquote p {
  font-family: var(--font-serif);
  font-size: clamp(24px, 3.2vw, 40px);
  color: var(--ink-2);
  line-height: 1.38;
  font-weight: 400;
}
.pullquote-end { color: var(--blue) !important; font-style: italic; margin-top: 8px; }

/* ── VALUE PROPS ─────────────────────────────────────────── */
.props-section {
  padding-bottom: 100px;
}
.props-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.prop {
  padding: 36px 28px;
  background: var(--white);
  border-right: 1px solid var(--line);
  transition: background 0.2s;
}
.prop:last-child { border-right: none; }
.prop:hover { background: var(--surface); }
.prop-icon {
  width: 38px;
  height: 38px;
  background: var(--blue-dim);
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--blue);
  margin-bottom: 18px;
}
.prop h3 { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; color: var(--ink); }
.prop p  { font-size: 13.5px; color: var(--ink-3); line-height: 1.65; }

/* ── SERVICES ────────────────────────────────────────────── */
.services-section { padding: 100px 0; }
.svc-list {
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.svc-row {
  display: grid;
  grid-template-columns: 280px 1fr;
  border-bottom: 1px solid var(--line);
  transition: background 0.13s;
}
.svc-row:last-child { border-bottom: none; }
.svc-row:hover { background: var(--surface); }
.svc-label {
  padding: 40px 32px;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.svc-num { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--blue); }
.svc-label h3 { font-size: 16px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; color: var(--ink); }
.svc-body { padding: 40px 48px; }
.svc-body p { font-size: 14.5px; color: var(--ink-3); line-height: 1.75; margin-bottom: 20px; max-width: 540px; }
.svc-features { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; }
.svc-features li {
  font-size: 13px;
  color: var(--ink-3);
  padding-left: 14px;
  position: relative;
}
.svc-features li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--blue);
}

/* ── PROCESS ─────────────────────────────────────────────── */
.process-section {
  padding: 100px 0;
  background: var(--ink);
  border-radius: 0;
}
.process-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--r-lg);
  overflow: hidden;
