<script>
  /* Portfolio filter */
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const workCards  = document.querySelectorAll<HTMLElement>('#workGrid .work-card');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      filterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      workCards.forEach(card => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.hidden = !match;
      });
    });
  });

  /* Nav shadow on scroll */
  const navEl = document.querySelector('.nav') as HTMLElement | null;
  window.addEventListener('scroll', () => {
    if (navEl) navEl.style.boxShadow = window.scrollY > 8 ? '0 2px 10px rgba(0,0,0,0.07)' : 'none';
  }, { passive: true });

  /* Mobile menu */
  const burgerBtn = document.getElementById('burger') as HTMLButtonElement | null;
  const drawerEl  = document.getElementById('drawer')  as HTMLElement | null;
  burgerBtn?.addEventListener('click', () => {
    const open = !drawerEl?.hidden;
    if (drawerEl) drawerEl.hidden = open;
    burgerBtn.setAttribute('aria-expanded', String(!open));
  });
  drawerEl?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      if (drawerEl) drawerEl.hidden = true;
      burgerBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  /* Reviews slider */
  (() => {
    const track   = document.getElementById('reviewsTrack') as HTMLElement | null;
    const prevBtn = document.getElementById('reviewsPrev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('reviewsNext') as HTMLButtonElement | null;
    const dotsEl  = document.getElementById('reviewsDots') as HTMLElement | null;
    if (!track || !prevBtn || !nextBtn || !dotsEl) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-card'));
    let perPage = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
    const pages = () => Math.ceil(cards.length / perPage);
    let current = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    function buildDots() {
      dotsEl!.innerHTML = '';
      for (let i = 0; i < pages(); i++) {
        const d = document.createElement('button');
        d.className = 'reviews-dot' + (i === current ? ' active' : '');
        d.setAttribute('role', 'tab');
        d.setAttribute('aria-label', `Go to page ${i + 1}`);
        d.addEventListener('click', () => { goTo(i); resetAuto(); });
        dotsEl!.appendChild(d);
      }
    }

    function goTo(page: number) {
      current = Math.max(0, Math.min(page, pages() - 1));
      const gap = 16;
      const cardW = cards[0]?.offsetWidth ?? 0;
      track!.style.transform = `translateX(-${current * (cardW + gap) * perPage}px)`;
      prevBtn!.disabled = current === 0;
      nextBtn!.disabled = current >= pages() - 1;
      dotsEl!.querySelectorAll<HTMLButtonElement>('.reviews-dot').forEach((d, i) => {
        d.classList.toggle('active', i === current);
      });
    }

    function resetAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => goTo(current >= pages() - 1 ? 0 : current + 1), 5000);
    }

    prevBtn.addEventListener('click', () => { goTo(current - 1); resetAuto(); });
    nextBtn.addEventListener('click', () => { goTo(current + 1); resetAuto(); });

    window.addEventListener('resize', () => {
      const newPer = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
      if (newPer !== perPage) { perPage = newPer; current = 0; buildDots(); goTo(0); }
    });

    buildDots();
    goTo(0);
    resetAuto();
  })();

  /* Scroll fade-in */
  const targets = document.querySelectorAll<HTMLElement>('.prop, .svc-row, .process-card, .work-card, .why-item, .review-card');
  targets.forEach(el => el.classList.add('js-fade'));
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.06 });
  targets.forEach(el => io.observe(el));

  /* Contact tabs */
  const tabs = document.querySelectorAll<HTMLButtonElement>('.contact-tab');
  const panelAppt = document.getElementById('panelAppt') as HTMLFormElement | null;
  const panelMsg  = document.getElementById('panelMsg')  as HTMLFormElement | null;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const isAppt = tab.dataset.tab === 'appointment';
      if (panelAppt) panelAppt.hidden = !isAppt;
      if (panelMsg)  panelMsg.hidden  =  isAppt;
    });
  });

  /* Restrict date picker: tomorrow onwards, Mon–Sat only */
  const dateInput = document.getElementById('appt-date') as HTMLInputElement | null;
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const pad = (n: number) => String(n).padStart(2, '0');
    const minDate = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth()+1)}-${pad(tomorrow.getDate())}`;
    dateInput.min = minDate;
    dateInput.addEventListener('change', () => {
      const d = new Date(dateInput.value + 'T00:00:00');
      const day = d.getDay(); // 0=Sun, 6=Sat
      if (day === 0) {
        dateInput.setCustomValidity('We are not available on Sundays. Please choose Monday–Saturday.');
        dateInput.reportValidity();
      } else {
        dateInput.setCustomValidity('');
      }
    });
  }

  const SUPABASE_URL = "https://abcuolcsfdvvzudvddse.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY3VvbGNzZmR2dnp1ZHZkZHNlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4NTA4MzMsImV4cCI6MjA5NTQyNjgzM30.ZBppMgg2bwp3l7GXC5H6eRZn9Wtdj1L40O_MicV9swk";

  async function submitForm(
    form: HTMLFormElement,
    type: 'appointment' | 'message',
    successEl: HTMLElement | null,
    errorEl: HTMLElement | null
  ) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const origText = btn.textContent ?? '';
    btn.textContent = 'Sending…';
    btn.disabled = true;
    if (successEl) successEl.hidden = true;
    if (errorEl)   errorEl.hidden   = true;

    const fd = new FormData(form);
    const payload: Record<string, string> = { type };
    fd.forEach((v, k) => { payload[k] = v as string; });

    try {
      const res = await fetch(`${SUPABASE_URL}/functions/v1/send-contact`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        form.reset();
        if (successEl) { successEl.hidden = false; setTimeout(() => { successEl.hidden = true; }, 8000); }
      } else {
        if (errorEl) { errorEl.hidden = false; }
      }
    } catch {
      if (errorEl) { errorEl.hidden = false; }
    } finally {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }

  panelAppt?.addEventListener('submit', e => {
    e.preventDefault();
    if (!panelAppt.checkValidity()) { panelAppt.reportValidity(); return; }
    submitForm(panelAppt, 'appointment', document.getElementById('apptSuccess'), document.getElementById('apptError'));
  });

  panelMsg?.addEventListener('submit', e => {
    e.preventDefault();
    if (!panelMsg.checkValidity()) { panelMsg.reportValidity(); return; }
    submitForm(panelMsg, 'message', document.getElementById('msgSuccess'), document.getElementById('msgError'));
  });
</script>
