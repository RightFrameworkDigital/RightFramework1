---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Seattle Web Design for Small Businesses | Right Framework Digital Agency"
  description="Right Framework helps Seattle small businesses get their first website online at the most affordable price in the market. Simple, fast, no hassle. Get your business found on Google today."
  canonicalURL="https://www.rightframework.tech/"
>

<!-- NAV -->
<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a href="/" class="logo" aria-label="Right Framework Digital Agency">
      <div class="logo-icon" aria-hidden="true">
        <img src="/ChatGPT_Image_May_29,_2026,_06_48_43_PM.png" alt="Right Framework Digital Agency logo" class="logo-img" width="56" height="56" />
      </div>
      <span class="logo-text-wrap">
        <span class="logo-name">RIGHT FRAMEWORK</span>
        <span class="logo-service">DIGITAL AGENCY</span>
        <span class="logo-tagline">SEATTLE'S FIRST WEBSITE PARTNER</span>
      </span>
    </a>
    <ul class="nav-links" role="list" aria-label="Main navigation">
      <li><a href="/" class="nav-active">Home</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Portfolio</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="#contact" class="nav-cta">Contact Us</a></li>
    </ul>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
  <div class="nav-drawer" id="drawer" hidden>
    <div class="wrap">
      <a href="#services">Services</a>
      <a href="#process">How It Works</a>
      <a href="#work">Our Work</a>
      <a href="/blog">Blog</a>
      <a href="#contact">Get a free quote</a>
      <a href="tel:+15097313450" class="drawer-call">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.42 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call us: (509) 731-3450
      </a>
    </div>
  </div>
</header>

<main>

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="kicker">Seattle's First Website Partner</p>
        <h1>Get Online.<br>Get Found.<br>Grow Your Business.</h1>
        <p class="hero-sub">We build professional websites for Seattle small businesses that attract customers, build trust, and help you grow online—without the complexity or agency jargon.</p>
        <div class="hero-btns">
          <a href="#services" class="btn btn-blue btn-lg">Our Services</a>
          <a href="#work" class="btn btn-ghost btn-lg">View Portfolio</a>
        </div>
        <p class="hero-guarantee">Transparent Pricing &mdash; No Surprises.</p>
      </div>
    </div>
  </div>
</section>

<!-- STATS BAR -->
<div class="stats-bar">
  <div class="wrap">
    <p class="stats-title">TRUSTED BY LOCAL BUSINESSES</p>
    <div class="stats-row">
      <div class="stat">
        <strong>50+</strong>
        <span>Seattle businesses launched</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat">
        <strong>7 days</strong>
        <span>Average time to go live</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat">
        <strong>$0 down</strong>
        <span>No upfront payment needed</span>
      </div>
      <div class="stat-sep" aria-hidden="true"></div>
      <div class="stat">
        <strong>Seattle</strong>
        <span>Local &amp; always available</span>
      </div>
    </div>
  </div>
</div>

<!-- PULL QUOTE -->
<section class="pullquote-section">
  <div class="wrap">
    <blockquote class="pullquote">
      <p>Most Seattle small businesses still don't have a website. Their competitors do.</p>
      <p class="pullquote-end">We fix that — fast and affordably.</p>
    </blockquote>
  </div>
</section>

<!-- VALUE PROPS -->
<section class="props-section">
  <div class="wrap">
    <div class="props-grid">
      <div class="prop">
        <div class="prop-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>Fast — online in days</h3>
        <p>We get your website live in as little as 7 days. No waiting months. Your business starts showing up online right away.</p>
      </div>
      <div class="prop">
        <div class="prop-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3>Most affordable price</h3>
        <p>We offer the lowest prices for professional websites in Seattle. If you find a better quote, we'll beat it — that's our promise.</p>
      </div>
      <div class="prop">
        <div class="prop-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2.5"/></svg>
        </div>
        <h3>Looks great on all devices</h3>
        <p>Your site works perfectly on phones, tablets, and computers. Most of your customers will find you on their phone.</p>
      </div>
      <div class="prop">
        <div class="prop-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <h3>Found on Google</h3>
        <p>Every website we build is set up to appear in Google search. When someone looks for your type of business in Seattle, you show up.</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="services-section" id="services">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">Our packages</p>
      <h2>Simple, honest pricing for Seattle small businesses</h2>
    </header>

    <div class="svc-list">
      <article class="svc-row">
        <div class="svc-label">
          <span class="svc-num">01</span>
          <h3>Starter Website</h3>
        </div>
        <div class="svc-body">
          <p>Perfect if you just need to get online. A clean, professional website that tells customers who you are, what you do, and how to reach you. Simple and done right.</p>
          <ul class="svc-features">
            <li>Up to 3 pages (Home, About, Contact)</li>
            <li>Mobile-friendly design</li>
            <li>Google-ready from day one</li>
            <li>Contact form &amp; phone number</li>
            <li>Live in 5–7 days</li>
            <li>Free domain setup</li>
          </ul>
        </div>
      </article>
      <article class="svc-row">
        <div class="svc-label">
          <span class="svc-num">02</span>
          <h3>Business Website</h3>
        </div>
        <div class="svc-body">
          <p>Everything in Starter, plus more pages, a gallery of your work, and stronger Google presence. Ideal for businesses that want to stand out and get found by more customers in Seattle.</p>
          <ul class="svc-features">
            <li>Up to 6 pages</li>
            <li>Photo gallery or portfolio</li>
            <li>Local SEO setup for Seattle</li>
            <li>Google Maps &amp; reviews integration</li>
            <li>Social media links</li>
            <li>Live in 7–10 days</li>
          </ul>
        </div>
      </article>
      <article class="svc-row">
        <div class="svc-label">
          <span class="svc-num">03</span>
          <h3>Growth Website</h3>
        </div>
        <div class="svc-body">
          <p>Built for businesses ready to grow. A fully custom website designed to bring in leads, rank higher on Google, and turn visitors into paying customers — all on autopilot.</p>
          <ul class="svc-features">
            <li>Unlimited pages</li>
            <li>Full custom design</li>
            <li>Advanced local SEO</li>
            <li>Blog or news section</li>
            <li>Lead capture forms</li>
            <li>Ongoing support included</li>
          </ul>
        </div>
      </article>
    </div>

    <div style="text-align:center; margin-top:40px;">
      <a href="#contact" class="btn btn-blue btn-lg">Get a free quote — no obligation</a>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process-section" id="process">
  <div class="wrap">
    <header class="sec-head sec-head-inv">
      <p class="label label-inv">How it works</p>
      <h2>Your website, live in days.<br>We handle everything.</h2>
    </header>
    <div class="process-grid">
      <div class="process-card">
        <span class="process-n" aria-hidden="true">1</span>
        <h3>Tell us about your business</h3>
        <p>We have a quick 20-minute call to understand your business, your customers, and what you need. No tech knowledge required — just tell us what you do.</p>
      </div>
      <div class="process-card">
        <span class="process-n" aria-hidden="true">2</span>
        <h3>We build your website</h3>
        <p>We design and build your site. You review it, give us feedback, and we make it exactly right. Nothing goes live until you love it.</p>
      </div>
      <div class="process-card">
        <span class="process-n" aria-hidden="true">3</span>
        <h3>Go live &amp; get found</h3>
        <p>Your site goes live and we submit it to Google. Customers in Seattle start finding your business online — often within days of launch.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHY US -->
<section class="why-section">
  <div class="wrap">
    <div class="why-grid">
      <div class="why-left">
        <p class="label">Why Right Framework</p>
        <h2>We exist for one reason: getting Seattle small businesses online</h2>
        <p>We're not a big agency chasing corporate contracts. We're a local Seattle team that works only with small businesses who need their first website — or want a better one.</p>
        <p>That means simple communication, honest pricing, and a team that actually cares about your business succeeding.</p>
        <a href="#contact" class="btn btn-blue btn-lg" style="margin-top: 8px;">Talk to us today — it's free</a>
      </div>
      <div class="why-right">
        <div class="why-item">
          <div class="why-check" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <strong>No confusing tech talk</strong>
            <p>We explain everything in plain English. You'll always know what's happening and why.</p>
          </div>
        </div>
        <div class="why-item">
          <div class="why-check" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <strong>Lowest price — guaranteed</strong>
            <p>Show us any competitor's quote and we'll beat it. No fine print.</p>
          </div>
        </div>
        <div class="why-item">
          <div class="why-check" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <strong>Seattle local focus</strong>
            <p>We know Seattle neighborhoods, customers, and what works for businesses here.</p>
          </div>
        </div>
        <div class="why-item">
          <div class="why-check" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <strong>We're with you after launch</strong>
            <p>Need to update your hours, add a photo, or change something? Just ask us — we've got you.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
        </div>
      </div>
    </div>
  </div>
</section>

