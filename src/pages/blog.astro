---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    slug: 'rank-1-google-seattle',
    title: 'How to Get Your Small Business to Rank #1 on Google in Seattle',
    date: 'May 15, 2026',
    dateISO: '2026-05-15',
    category: 'SEO',
    readTime: 6,
    excerpt: 'Local SEO in a competitive city like Seattle takes more than just a Google Business Profile. Here\'s the exact framework we use to push small business websites to the top of local search results.',
  },
  {
    slug: 'trades-business-needs-website-2026',
    title: 'Why Every Trades Business Needs a Website in 2026',
    date: 'March 12, 2025',
    dateISO: '2025-03-12',
    category: 'Web Design',
    readTime: 5,
    excerpt: 'Word of mouth is powerful, but it has a ceiling. A well-built website works 24/7 to bring in qualified leads — even while you\'re on the job.',
  },
  {
    slug: '5-signs-website-hurting-business',
    title: '5 Signs Your Website Is Hurting Your Business',
    date: 'November 3, 2024',
    dateISO: '2024-11-03',
    category: 'Web Design',
    readTime: 4,
    excerpt: 'A bad website doesn\'t just fail to convert — it actively drives customers away. If your site has any of these five problems, you\'re leaving money on the table every single day.',
  },
  {
    slug: 'restaurant-food-business-needs-website',
    title: 'Why Your Restaurant or Food Business Needs a Website in 2026',
    date: 'May 20, 2026',
    dateISO: '2026-05-20',
    category: 'Restaurant & Food Business',
    readTime: 5,
    excerpt: 'Seattle restaurants that skip a website are leaving tables empty. Customers search online before they dine — here\'s how to make sure they find you first.',
  },
  {
    slug: 'adult-family-homes-google-search',
    title: 'How Adult Family Homes Can Get More Residents Through Google Search',
    date: 'July 8, 2023',
    dateISO: '2023-07-08',
    category: 'Health & Wellness',
    readTime: 7,
    excerpt: 'Families searching for care options turn to Google first. Here\'s how adult family homes in Seattle and the Pacific Northwest can fill vacancies faster through smart SEO.',
  },
  {
    slug: 'top-5-website-mistakes-seattle',
    title: 'Top 5 Website Mistakes Small Businesses in Seattle Are Making',
    date: 'February 19, 2022',
    dateISO: '2022-02-19',
    category: 'Web Design',
    readTime: 4,
    excerpt: 'These five website mistakes are costing Seattle small businesses customers every single day. Find out if your site is making them — and how to fix them fast.',
  },
];

const categories = ['All', ...Array.from(new Set(posts.map(p => p.category)))];
---

<Layout
  title="Web Design & SEO Blog | Right Framework Digital Inc."
  description="SEO tips, web design insights, and digital marketing advice for Seattle small businesses. Practical guides from the team at Right Framework Digital Inc."
  canonicalURL="https://www.rightframework.tech/blog"
>

<header class="blog-nav">
  <div class="wrap blog-nav-inner">
    <a href="/" class="logo" aria-label="Right Framework Digital Agency">
      <div class="logo-icon" aria-hidden="true">
        <img src="/ChatGPT_Image_May_29,_2026,_06_48_43_PM.png" alt="Right Framework Digital Agency logo" class="logo-img" width="56" height="56" />
      </div>
      <span class="logo-text-wrap">
        <span class="logo-name">RIGHT FRAMEWORK</span>
        <span class="logo-service">DIGITAL AGENCY</span>
        <span class="logo-tagline">SEATTLE'S FIRST WEBSITE PARTNER</span>
      </span>
    </a>
    <nav aria-label="Main navigation" class="desktop-nav">
      <a href="/#services">Services</a>
      <a href="/#process">Process</a>
      <a href="/#work">Work</a>
      <a href="/blog" class="active">Blog</a>
      <a href="/#contact" class="btn btn-dark">Contact Us</a>
    </nav>
    <button class="burger" id="blog-burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
  <div class="blog-drawer" id="blog-drawer" hidden>
    <div class="wrap">
      <a href="/">Home</a>
      <a href="/#services">Services</a>
      <a href="/#process">Process</a>
      <a href="/#work">Work</a>
      <a href="/blog">Blog</a>
      <a href="/#contact">Contact Us</a>
    </div>
  </div>
</header>

<script>
  const burger = document.getElementById('blog-burger');
  const drawer = document.getElementById('blog-drawer');
  burger?.addEventListener('click', () => {
    const open = drawer?.hidden === false;
    if (drawer) drawer.hidden = open;
    burger.setAttribute('aria-expanded', String(!open));
  });
</script>

<section class="blog-hero">
  <div class="wrap">
    <p class="blog-label">Insights &amp; Resources</p>
    <h1>SEO Tips, Web Design Trends &amp; Digital Marketing Advice for Small Businesses</h1>
    <p class="blog-sub">Practical guides from the team at Right Framework Digital — helping Pacific Northwest businesses grow online.</p>
  </div>
</section>

<main class="blog-main" id="main-content">
  <div class="wrap">

    <div class="category-filters" id="categoryFilters" role="tablist" aria-label="Filter posts by category">
      {categories.map((cat, i) => (
        <button
          class={`filter-btn${i === 0 ? ' active' : ''}`}
          data-category={cat}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="posts-grid" id="postsGrid">
      {posts.map(post => (
        <article class="post-card" data-category={post.category}>
          <div class="post-card-body">
            <div class="post-meta">
              <span class="post-cat">{post.category}</span>
              <time datetime={post.dateISO} class="post-date">{post.date}</time>
            </div>
            <h2 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="post-excerpt">{post.excerpt}</p>
          </div>
          <div class="post-card-footer">
            <span class="read-time">{post.readTime} min read</span>
            <a href={`/blog/${post.slug}`} class="read-more-btn">Read More <span class="arrow">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>

    <p class="no-posts-msg" id="noPostsMsg" hidden>No posts in this category yet.</p>
  </div>
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <div class="footer-logo-icon" aria-hidden="true">
            <img src="/image copy.png" alt="Right Framework Digital Agency logo" class="footer-logo-img" width="52" height="52" />
          </div>
          <span class="footer-logo-name">Right Framework Digital Inc.</span>
        </a>
        <p class="footer-tagline">Seattle web design for Pacific Northwest small businesses.</p>
        <p class="footer-company-name">Right Framework Digital Inc.</p>
        <p class="footer-sub">A digital agency helping businesses grow online.</p>
        <div class="footer-socials" aria-label="Social media links">
          <a href="https://www.tiktok.com/@rightframework" target="_blank" rel="noopener" aria-label="TikTok"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg></a>
          <a href="https://www.facebook.com/rightframework" target="_blank" rel="noopener" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          <a href="https://www.instagram.com/rightframework" target="_blank" rel="noopener" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
          <a href="https://www.linkedin.com/company/rightframework" target="_blank" rel="noopener" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <a href="/#services">Website Design</a>
        <a href="/#services">UI/UX Design</a>
        <a href="/#services">SEO Optimization</a>
        <a href="/#services">Website Redesign</a>
      </div>
      <div class="footer-col">
        <h4>Support</h4>
        <a href="/#process">Our Process</a>
        <a href="/#work">Our Work</a>
        <a href="/#contact">Contact</a>
        <a href="/privacy-policy">Privacy Policy</a>
      </div>
      <div class="footer-col">
        <h4>Pages</h4>
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/#contact">Contact</a>
      </div>
    </div>
  </div>
  <div class="footer-copyright">
    <div class="wrap">
      <p>Copyright &copy; 2026 Right Framework Digital Inc. | Designed by <a href="https://rightframework.tech" target="_blank" rel="noopener">Right Framework</a> | <a href="/privacy-policy">Privacy Policy</a></p>
    </div>
  </div>
</footer>

</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');
  const noMsg = document.getElementById('noPostsMsg');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category || 'All';
      filterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      let visible = 0;
      cards.forEach(card => {
        const show = cat === 'All' || card.dataset.category === cat;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (noMsg) noMsg.hidden = visible > 0;
    });
  });
</script>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 6.5vw, 80px); }

  .blog-nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .blog-nav-inner { display: flex; align-items: center; justify-content: space-between; height: 88px; }
  .logo { display: flex; align-items: center; gap: 16px; text-decoration: none; }
  .logo-icon { width: 56px; height: 56px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .logo-img { width: 56px; height: 56px; object-fit: contain; flex-shrink: 0; }
  .logo-text-wrap { display: flex; flex-direction: column; justify-content: center; gap: 3px; }
  .logo-name { font-size: 17px; font-weight: 800; color: #0d2b5e; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase; }
  .logo-service { font-size: 10px; font-weight: 500; color: #5a7090; letter-spacing: 0.28em; text-transform: uppercase; line-height: 1; }
  .logo-tagline { font-size: 9px; font-weight: 600; color: #1a7fc1; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1; }
  .logo-motto { display: none; }
  .desktop-nav { display: flex; align-items: center; gap: 2px; }
  .desktop-nav a { font-size: 13.5px; font-weight: 600; color: #3a4a5c; padding: 7px 16px; border-radius: 7px; white-space: nowrap; letter-spacing: 0.04em; text-transform: uppercase; transition: color 0.12s, background 0.12s; text-decoration: none; }
  .desktop-nav a:hover { color: #0d2b5e; background: var(--surface); }
  .desktop-nav a.active { color: #1a7fc1; border-bottom: 2px solid #1a7fc1; border-radius: 0; padding-bottom: 5px; }
  .btn-dark { background: #0d2b5e !important; color: #fff !important; margin-left: 12px; padding: 7px 16px !important; border-radius: 6px !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; height: 36px; display: inline-flex; align-items: center; }
  .btn-dark:hover { background: #1a3f7a !important; color: #fff !important; }
  .burger { display: none; flex-direction: column; justify-content: center; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; width: 36px; height: 36px; }
  .burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: all 0.2s; }
  .blog-drawer { background: #fff; border-top: 1px solid var(--line); padding: 16px 0 24px; }
  .blog-drawer .wrap { display: flex; flex-direction: column; gap: 4px; }
  .blog-drawer a { font-size: 15px; font-weight: 500; color: var(--ink-2); padding: 10px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .footer-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 12px; }
  .footer-logo-icon { width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .footer-logo-img { width: 52px; height: 52px; object-fit: contain; }
  .footer-logo-name { font-size: 15px; font-weight: 600; color: var(--ink); }

  .blog-hero { padding: 80px 0 64px; border-bottom: 1px solid var(--line); }
  .blog-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin-bottom: 16px; }
  .blog-hero h1 { font-size: clamp(24px, 3.6vw, 40px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; color: var(--ink); margin-bottom: 20px; max-width: 680px; }
  .blog-sub { font-size: 16px; color: var(--ink-3); max-width: 540px; line-height: 1.7; }

  .blog-main { padding: 56px 0 96px; }
  .category-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .filter-btn { font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: 8px; border: 1.5px solid #c8cdd6; background: var(--white); color: #3a4a5c; cursor: pointer; letter-spacing: 0.04em; text-transform: uppercase; transition: all 0.15s; white-space: nowrap; }
  .filter-btn:hover { border-color: #0d2b5e; color: #0d2b5e; background: var(--surface); }
  .filter-btn.active { background: #0d2b5e; color: #fff; border-color: #0d2b5e; }

  .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .post-card { background: var(--white); border: 1px solid var(--line); border-radius: 16px; display: flex; flex-direction: column; transition: box-shadow 0.25s, transform 0.25s; overflow: hidden; }
  .post-card:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.08); transform: translateY(-3px); }
  .post-card-body { padding: 32px 28px 20px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .post-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .post-cat { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #1a7fc1; background: rgba(26,127,193,0.10); padding: 3px 10px; border-radius: 100px; white-space: nowrap; }
  .post-date { font-size: 12.5px; color: var(--ink-4); }
  .post-title { font-size: 17px; font-weight: 700; line-height: 1.3; letter-spacing: -0.02em; color: var(--ink); }
  .post-title a { text-decoration: none; color: inherit; transition: color 0.13s; }
  .post-title a:hover { color: #1a7fc1; }
  .post-excerpt { font-size: 14px; color: #475569; line-height: 1.7; flex: 1; }
  .post-card-footer { padding: 16px 28px 24px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); gap: 12px; }
  .read-time { font-size: 12.5px; color: var(--ink-4); font-weight: 500; }
  .read-more-btn { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; font-size: 13px; font-weight: 600; color: #1a7fc1; text-decoration: none; transition: color 0.18s; }
  .read-more-btn .arrow { display: inline-block; transition: transform 0.2s ease; }
  .post-card:hover .read-more-btn .arrow { transform: translateX(4px); }
  .read-more-btn:hover { color: #0d2b5e; }
  .no-posts-msg { text-align: center; color: var(--ink-4); font-size: 15px; padding: 48px 0; }

  .site-footer { background: #f5f5f5; border-top: 1px solid #e4e4e4; }
  .footer-top { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr; gap: 32px; padding-top: 64px; padding-bottom: 48px; align-items: flex-start; }
  .footer-brand { max-width: 280px; }
  .footer-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 12px; }
  .footer-logo span { font-size: 15px; font-weight: 600; color: var(--ink); }
  .footer-tagline { font-size: 13px; color: var(--ink-3); line-height: 1.65; margin: 0 0 6px; }
  .footer-company-name { font-size: 13px; font-weight: 600; color: var(--ink-2); margin: 0 0 4px; }
  .footer-sub { font-size: 12.5px; color: var(--ink-4); margin: 0 0 16px; }
  .footer-socials { display: flex; gap: 8px; }
  .footer-socials a { width: 34px; height: 34px; border-radius: 8px; background: #fff; border: 1px solid #e4e4e4; color: #555; display: flex; align-items: center; justify-content: center; transition: color 0.13s, border-color 0.13s; text-decoration: none; }
  .footer-socials a:hover { color: var(--ink); border-color: #aaa; }
  .footer-col { display: flex; flex-direction: column; gap: 10px; }
  .footer-col h4 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-4); margin-bottom: 4px; }
  .footer-col a { font-size: 13.5px; color: var(--ink-3); text-decoration: none; transition: color 0.13s; }
  .footer-col a:hover { color: var(--ink); }
  .footer-copyright { background: #ebebeb; border-top: 1px solid #e0e0e0; padding: 14px 0; }
  .footer-copyright p { font-size: 12px; color: #888; text-align: center; }
  .footer-copyright a { color: #666; text-decoration: none; }
  .footer-copyright a:hover { color: var(--ink); }

  @media (max-width: 1024px) { .posts-grid { grid-template-columns: 1fr 1fr; } .footer-top { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; max-width: 100%; } }
  @media (max-width: 768px) {
    .blog-hero { padding: 56px 0 48px; }
    .desktop-nav { display: none; }
    .burger { display: flex; }
    .posts-grid { grid-template-columns: 1fr; }
    .blog-nav-inner { height: 72px; }
    .logo-icon { width: 40px !important; height: 40px !important; }
    .logo-img { width: 40px !important; height: 40px !important; }
    .logo-name { font-size: 13px; }
    .logo-service { display: none; }
    .logo-tagline { display: none; }
  }
  @media (max-width: 540px) { .footer-top { grid-template-columns: 1fr; } .post-card-footer { flex-wrap: wrap; } }
</style>
